{
  "name": "solarwinds/autoinstrumentation-php",
  "description": "Solarwinds OpenTelemetry PHP auto-instrumentation packages (8.2+) to include in the image used by OpenTelemetry Operator for Kubernetes",
  "type": "project",
  "require": {
    "open-telemetry/opentelemetry-auto-aws-sdk": "^0.4",
    "open-telemetry/opentelemetry-auto-curl": "^0.4",
    "open-telemetry/opentelemetry-auto-guzzle": "^1.3",
    "open-telemetry/opentelemetry-auto-http-async": "^1.2",
    "open-telemetry/opentelemetry-auto-io": "^0.3",
    "open-telemetry/opentelemetry-auto-laravel": "^1.7",
    "open-telemetry/opentelemetry-auto-mongodb": "^0.4",
    "open-telemetry/opentelemetry-auto-mysqli": "^0.4",
    "open-telemetry/opentelemetry-auto-openai-php": "^0.3",
    "open-telemetry/opentelemetry-auto-pdo": "^0.5",
    "open-telemetry/opentelemetry-auto-postgresql": "^0.4",
    "open-telemetry/opentelemetry-auto-psr3": "^0.3",
    "open-telemetry/opentelemetry-auto-psr6": "^0.0.8",
    "open-telemetry/opentelemetry-auto-psr14": "^0.0.7",
    "open-telemetry/opentelemetry-auto-psr15": "^1.2",
    "open-telemetry/opentelemetry-auto-psr16": "^0.0.7",
    "open-telemetry/opentelemetry-auto-psr18": "^1.2",
    "open-telemetry/opentelemetry-auto-reactphp": "^0.5",
    "open-telemetry/opentelemetry-auto-session": "^0.3",
    "open-telemetry/opentelemetry-auto-slim": "^1.4",
    "open-telemetry/opentelemetry-metrics-runtime": "^0.2",
    "open-telemetry/opentelemetry-sqlcommenter": "^0.3",
    "solarwinds/apm": "^9.0@alpha",
    "php-http/guzzle7-adapter": "^1.0",
    "nyholm/psr7-server": "^1.1"
  },
  "provide": {
    "laravel/framework": "*",
    "slim/slim": "*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  }
}
